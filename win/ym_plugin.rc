/* Métadonnées Windows de libym_plugin.dll (Propriétés -> Détails) */
#include <winver.h>
#include "../src/version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     YM_PLUGIN_VERSION_RC
PRODUCTVERSION  YM_PLUGIN_VERSION_RC
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName",      YM_PLUGIN_AUTHOR
            VALUE "FileDescription",  "Plugin VLC 3.0 - lecture des musiques YM (Amstrad CPC, Atari ST)"
            VALUE "FileVersion",      YM_PLUGIN_VERSION
            VALUE "InternalName",     "libym_plugin"
            VALUE "OriginalFilename", "libym_plugin.dll"
            VALUE "ProductName",      "vlc-ym"
            VALUE "ProductVersion",   YM_PLUGIN_VERSION
            VALUE "LegalCopyright",   "(C) " YM_PLUGIN_YEAR " " YM_PLUGIN_AUTHOR " <" YM_PLUGIN_EMAIL ">. Moteur ST-Sound (C) Arnaud Carre (MIT)."
            VALUE "Comments",         YM_PLUGIN_WEBSITE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
