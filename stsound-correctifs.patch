+// [vlc-ym] Durcissement contre les fichiers corrompus :
+// - chaque buffer décodé est suivi de YM_SAFE_PAD octets à zéro, ce qui rend
+//   inoffensives les petites lectures au-delà de la fin (champs d'en-tête,
+//   chaînes non terminées) ;
+// - les champs pouvant faire lire loin (tailles, nombres de frames) sont
+//   vérifiés explicitement dans ymDecode().
+#define	YM_SAFE_PAD			65536
+#define	YM_MAX_DEPACKED		(64u<<20)
+
+static ymu8 *padBuffer(ymu8 *p, ymu32 size)
+{
+	ymu8 *n = (ymu8*)realloc(p, (size_t)size + YM_SAFE_PAD);
+	if (!n)
+	{
+		free(p);
+		return NULL;
+	}
+	memset(n + size, 0, YM_SAFE_PAD);
+	return n;
+}
